  "mc_settings_emote_size_desc": {
    "message": "Множитель разрешения для эмоутов в чате. 1x — чёткий и компактный, 2x — оптимально для большинства экранов, 4x — для тех, кто хочет видеть каждый пиксель."
  },
  "mc_settings_input_preview_desc": {
    "message": "Показывает эмоуты как картинки прямо в поле ввода во время набора, вместо текстовых имён. Что видите, то и отправите."
  },
  "mc_settings_clickable_links_desc": {
    "message": "Превращает URL в сообщениях в кликабельные ссылки. Отключите, если предпочитаете копировать-вставлять или не доверяете незнакомцам в интернете."
  },
  "mc_settings_vi_mode_desc": {
    "message": "Vim-биндинги для навигации по чату. j/k — прокрутка, g/G — верх/низ, / — поиск. Для тех, кто считает, что мышь — для казуалов."
  },
  "mc_settings_zebra_desc": {
    "message": "Чередующаяся подсветка строк в чате. Помогает следить за длинными сообщениями, особенно при быстром чате."
  },
  "mc_settings_auto_hide_desc": {
    "message": "Скрывает поле ввода, когда вы не пишете сообщение. Кликните или начните печатать, чтобы вернуть. Максимизирует область просмотра чата."
  },
  "mc_settings_timestamps_desc": {
    "message": "Показывает время отправки каждого сообщения рядом с ником. Удобно, чтобы понять, что произошло пока вы были AFK."
  },
  "mc_settings_avatars_desc": {
    "message": "Показывает аватары рядом с никами в чате. Помогает визуально узнавать постоянных зрителей, занимает немного вертикального места."
  },
  "mc_settings_inline_notifs": {
    "message": "встроенные уведомления"
  },
  "mc_settings_notif_op": {
    "message": "[OP] оригинальные посты"
  },
  "mc_settings_notif_op_reply": {
    "message": "[OP] OP отвечает в своём треде"
  },
  "mc_settings_notif_re": {
    "message": "[RE] ответы"
  },
  "mc_settings_notif_dm": {
    "message": "[DM] шёпоты и DM"
  },
  "mc_settings_notif_op_desc": {
    "message": "Уведомление в активной вкладке чата, когда кто-то создаёт новый пост в ленте."
  },
  "mc_settings_notif_op_reply_desc": {
    "message": "Уведомление, когда автор оригинального поста отвечает в своём треде."
  },
  "mc_settings_notif_re_desc": {
    "message": "Уведомление о каждом ответе в любом треде ленты."
  },
  "mc_settings_notif_dm_desc": {
    "message": "Уведомление, когда вам приходит шёпот или DM."
  },
  "mc_settings_twitch_events": {
    "message": "события Twitch"
  },
  "mc_settings_raids": {
    "message": "рейды"
  },
  "mc_settings_raids_desc": {
    "message": "Встроенный баннер при входящем или исходящем рейде, с количеством зрителей и каналом-источником. Позволяет переехать на следующую трансляцию."
  },
  "mc_settings_hype_trains": {
    "message": "hype trains"
  },
  "mc_settings_hype_trains_desc": {
    "message": "Живой баннер прогресса hype train с уровнем и таймером вклада. По умолчанию выключен — на больших каналах срабатывает постоянно."
  },
  "mc_settings_gift_subs": {
    "message": "подаренные сабы"
  },
  "mc_settings_gift_subs_desc": {
    "message": "Баннер для массовых раздач сабов и индивидуальных подарков с указанием дарителя, получателя и тира."
  },
  "mc_settings_redeems": {
    "message": "обмены каналпоинтов"
  },
  "mc_settings_redeems_desc": {
    "message": "Встроенное уведомление об обменах каналпоинтов, например «подсветить моё сообщение» — чтобы видеть, на что зрители тратят поинты."
  },
  "mc_settings_prediction_banner": {
    "message": "предсказания"
