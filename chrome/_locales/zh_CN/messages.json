  "mc_settings_emote_size_desc": {
    "message": "聊天表情的分辨率倍率。1x 清晰紧凑，2x 适合大多数屏幕，4x 适合想逐像素欣赏表情的你。"
  },
  "mc_settings_input_preview_desc": {
    "message": "输入时直接在输入框中将表情显示为图片而非文字名称。所见即所发。"
  },
  "mc_settings_clickable_links_desc": {
    "message": "将聊天消息中的 URL 转换为可点击链接。如果你喜欢复制粘贴或不信任陌生人，可以关闭此功能。"
  },
  "mc_settings_vi_mode_desc": {
    "message": "聊天导航的 vim 风格键位绑定。j/k 滚动，g/G 到顶/底，/ 搜索。适合觉得鼠标是休闲玩意的人。"
  },
  "mc_settings_zebra_desc": {
    "message": "聊天消息交替行阴影。在窗口宽或聊天速度快时更容易追踪长消息。"
  },
  "mc_settings_auto_hide_desc": {
    "message": "不在编写消息时隐藏输入栏。点击或开始输入时重新显示。最大化聊天显示空间。"
  },
  "mc_settings_timestamps_desc": {
    "message": "在用户名旁显示每条消息的发送时间。适合用来补看 AFK 期间发生的事。"
  },
  "mc_settings_avatars_desc": {
    "message": "在聊天用户名旁显示头像。更容易一眼认出常客，但会占用少量垂直空间。"
