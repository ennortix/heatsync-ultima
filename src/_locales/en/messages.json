  "mc_settings_emote_size_desc": {
    "message": "Resolution multiplier for emotes in chat. 1x is crisp and compact, 2x is the sweet spot for most displays, 4x is for when you want to see every pixel of that emote art."
  },
  "mc_settings_input_preview_desc": {
    "message": "Shows emotes as images directly in the input box as you type, instead of plain text names. What you see is what you send."
  },
  "mc_settings_clickable_links_desc": {
    "message": "Turns URLs in chat messages into clickable hyperlinks. Disable if you prefer to copy-paste or just don't trust strangers on the internet."
  },
  "mc_settings_vi_mode_desc": {
    "message": "Vim-style keybindings for chat navigation. j/k to scroll, g/G for top/bottom, / to search. For people who think mice are for casuals."
  },
  "mc_settings_zebra_desc": {
    "message": "Alternating row shading on chat messages. Makes it easier to track long messages across the window, especially during fast chat."
  },
  "mc_settings_auto_hide_desc": {
    "message": "Hides the input bar when you're not actively composing a message. Click or start typing to bring it back. Maximizes chat viewing space."
  },
  "mc_settings_timestamps_desc": {
    "message": "Shows the time each message was sent, right next to the username. Useful for catching up on what happened while you were AFK."
  },
  "mc_settings_avatars_desc": {
    "message": "Displays profile pictures next to usernames in chat. Makes it easier to visually identify regulars at a glance, costs a bit of vertical space."
  },
  "mc_settings_inline_notifs": {
    "message": "inline notifications"
  },
  "mc_settings_notif_op": {
    "message": "[OP] original posts"
  },
  "mc_settings_notif_op_reply": {
    "message": "[OP] OP replies in own thread"
  },
  "mc_settings_notif_re": {
    "message": "[RE] replies"
  },
  "mc_settings_notif_dm": {
    "message": "[DM] whispers & DMs"
  },
  "mc_settings_notif_op_desc": {
    "message": "Notification in your active chat tab when someone creates a new original post on the feed."
  },
  "mc_settings_notif_op_reply_desc": {
    "message": "Notification when the original poster replies in their own thread."
  },
  "mc_settings_notif_re_desc": {
    "message": "Notification for every reply posted to any thread on the feed."
  },
  "mc_settings_notif_dm_desc": {
    "message": "Notification when you receive a whisper or DM."
  },
  "mc_settings_twitch_events": {
    "message": "twitch events"
  },
  "mc_settings_raids": {
    "message": "raids"
  },
  "mc_settings_raids_desc": {
    "message": "Inline banner when a streamer raids in or out, with viewer count and source channel. Lets you ride along to the next stream."
  },
  "mc_settings_hype_trains": {
    "message": "hype trains"
  },
  "mc_settings_hype_trains_desc": {
    "message": "Live progress banner for hype trains, showing level and contribution timer. Off by default since they fire constantly on big channels."
  },
  "mc_settings_gift_subs": {
    "message": "gift subs"
  },
  "mc_settings_gift_subs_desc": {
    "message": "Banner for community gift sub bombs and individual gifts, with gifter, recipient, and tier."
  },
  "mc_settings_redeems": {
    "message": "channel point redeems"
  },
  "mc_settings_redeems_desc": {
    "message": "Inline notice for channel point redemptions like 'highlight my message' so you can see what people are spending points on."
  },
  "mc_settings_prediction_banner": {
    "message": "predictions"
  },
  "mc_settings_prediction_banner_desc": {
    "message": "Live channel point prediction banner with current odds and time remaining to lock in a vote."
  },
  "mc_settings_poll_banner": {
    "message": "polls"
  },
  "mc_settings_poll_banner_desc": {
    "message": "Active poll banner with vote tallies and time remaining. Vote directly from the overlay."
  },
  "mc_settings_pinned_messages": {
    "message": "pinned messages"
  },
  "mc_settings_pinned_messages_desc": {
    "message": "Sticky banner for moderator-pinned chat messages so you don't miss the rules or the schedule."
  },
  "mc_settings_dim_timeouts": {
    "message": "dim timed-out messages"
  },
  "mc_settings_dim_timeouts_desc": {
    "message": "Show timed-out and banned messages at 50% opacity instead of hiding them, FFZ/BTTV style. Lets you see what got nuked without leaving chat."
  },
  "mc_settings_smart_completion": {
    "message": "smart tab completion"
  },
  "mc_settings_smart_completion_desc": {
    "message": "Recent chatters and emotes in this channel surface first when tab-completing. Faster than alphabetical when chat is moving."
  },
  "mc_settings_first_chatter": {
    "message": "first-message glow"
  },
  "mc_settings_first_chatter_desc": {
    "message": "Orange edge marker on the first message a user sends in each channel this session. Makes new arrivals easy to spot in fast chat."
  },
  "mc_settings_keyword_highlights": {
    "message": "keyword highlights"
  },
  "mc_settings_keyword_highlights_desc": {
    "message": "Messages containing any of these words get an orange tint, like a personal mention. Newline-separated, case-insensitive, whole-word matches."
  },
  "mc_settings_keyword_highlights_placeholder": {
    "message": "one keyword per line"
  },
  "mc_settings_features": {
