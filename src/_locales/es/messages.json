  "mc_settings_emote_size_desc": {
    "message": "Multiplicador de resolución para emotes en el chat. 1x es nítido y compacto, 2x es el punto óptimo para la mayoría de pantallas, 4x es para cuando quieres ver cada píxel de ese arte."
  },
  "mc_settings_input_preview_desc": {
    "message": "Muestra los emotes como imágenes directamente en el cuadro de entrada mientras escribes, en lugar de los nombres en texto. Lo que ves es lo que envías."
  },
  "mc_settings_clickable_links_desc": {
    "message": "Convierte las URLs en mensajes del chat en hipervínculos clicables. Desactiva si prefieres copiar y pegar o simplemente no te fías de los desconocidos en internet."
  },
  "mc_settings_vi_mode_desc": {
    "message": "Atajos estilo Vim para la navegación del chat. j/k para desplazarse, g/G para arriba/abajo, / para buscar. Para los que creen que el ratón es para novatos."
  },
  "mc_settings_zebra_desc": {
    "message": "Sombreado alternado en los mensajes del chat. Facilita el seguimiento de mensajes largos en la ventana, especialmente durante chats rápidos."
  },
  "mc_settings_auto_hide_desc": {
    "message": "Oculta la barra de entrada cuando no estás escribiendo un mensaje. Haz clic o empieza a escribir para mostrarla. Maximiza el espacio de visualización del chat."
  },
  "mc_settings_timestamps_desc": {
    "message": "Muestra la hora de envío de cada mensaje, junto al nombre de usuario. Útil para ponerse al día con lo que pasó mientras estabas AFK."
  },
  "mc_settings_avatars_desc": {
    "message": "Muestra fotos de perfil junto a los nombres de usuario en el chat. Facilita identificar visualmente a los habituales de un vistazo, ocupa un poco más de espacio vertical."
  },
