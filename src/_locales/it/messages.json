  },
  "mc_settings_emote_size_desc": {
    "message": "Moltiplicatore di risoluzione delle emote in chat. 1x è nitido e compatto, 2x è il punto ideale per la maggior parte dei monitor, 4x è per chi vuole vedere ogni pixel dell'arte."
  },
  "mc_settings_input_preview_desc": {
    "message": "Mostra le emote come immagini direttamente nel campo input mentre scrivi, invece dei nomi testuali. Ciò che vedi è ciò che invii."
  },
  "mc_settings_clickable_links_desc": {
    "message": "Trasforma gli URL nei messaggi della chat in link cliccabili. Disattiva se preferisci copiare e incollare o non ti fidi degli sconosciuti su internet."
  },
  "mc_settings_vi_mode_desc": {
    "message": "Scorciatoie stile Vim per la navigazione in chat. j/k per scorrere, g/G per inizio/fine, / per cercare. Per chi pensa che il mouse sia per casual."
  },
  "mc_settings_zebra_desc": {
    "message": "Sfumatura alternata sui messaggi della chat. Aiuta a seguire messaggi lunghi nella finestra, soprattutto durante chat veloci."
  },
  "mc_settings_auto_hide_desc": {
    "message": "Nasconde la barra input quando non stai scrivendo un messaggio. Clicca o inizia a digitare per riattivarla. Massimizza lo spazio di visualizzazione della chat."
  },
  "mc_settings_timestamps_desc": {
    "message": "Mostra l'orario di invio di ogni messaggio, accanto al nome utente. Utile per capire cosa è successo mentre eri AFK."
  },
  "mc_settings_avatars_desc": {
    "message": "Mostra le foto profilo accanto ai nomi utente in chat. Aiuta a identificare visivamente i frequentatori, costa un po' di spazio verticale."
  },
  "mc_settings_inline_notifs": {
    "message": "notifiche inline"
  },
  "mc_settings_notif_op": {
    "message": "[OP] post originali"
  },
  "mc_settings_notif_op_reply": {
    "message": "[OP] OP risponde nel proprio thread"
  },
  "mc_settings_notif_re": {
    "message": "[RE] risposte"
  },
  "mc_settings_notif_dm": {
    "message": "[DM] sussurri e DM"
  },
  "mc_settings_notif_op_desc": {
    "message": "Notifica nel tab chat attivo quando qualcuno crea un nuovo post originale nel feed."
  },
  "mc_settings_notif_op_reply_desc": {
    "message": "Notifica quando l'autore originale risponde nel proprio thread."
  },
  "mc_settings_notif_re_desc": {
    "message": "Notifica per ogni risposta postata in qualsiasi thread del feed."
  },
  "mc_settings_notif_dm_desc": {
    "message": "Notifica quando ricevi un sussurro o DM."
  },
  "mc_settings_twitch_events": {
    "message": "eventi Twitch"
  },
  "mc_settings_raids": {
    "message": "raid"
  },
  "mc_settings_raids_desc": {
    "message": "Banner inline quando uno streamer fa raid in entrata o uscita, con conteggio spettatori e canale di origine. Ti permette di seguire alla prossima stream."
  },
  "mc_settings_hype_trains": {
    "message": "hype train"
  },
  "mc_settings_hype_trains_desc": {
    "message": "Banner di progresso live per hype train, con livello e timer di contributo. Disattivato di default perché si attiva di continuo sui canali grossi."
  },
  "mc_settings_gift_subs": {
    "message": "abbonamenti regalati"
  },
  "mc_settings_gift_subs_desc": {
    "message": "Banner per regali sub di massa alla community e regali individuali, con regalante, destinatario e tier."
  },
  "mc_settings_redeems": {
    "message": "riscatti punti canale"
  },
  "mc_settings_redeems_desc": {
    "message": "Avviso inline per riscatti punti canale come 'evidenzia il mio messaggio', così vedi su cosa la gente spende i punti."
  },
  "mc_settings_prediction_banner": {
    "message": "predizioni"
  },
  "mc_settings_prediction_banner_desc": {
    "message": "Banner live di predizione punti canale con quote attuali e tempo restante per confermare il voto."
  },
  "mc_settings_poll_banner": {
    "message": "sondaggi"
  },
  "mc_settings_poll_banner_desc": {
    "message": "Banner sondaggio attivo con conteggi voti e tempo restante. Vota direttamente dall'overlay."
  },
  "mc_settings_pinned_messages": {
    "message": "messaggi fissati"
  },
  "mc_settings_pinned_messages_desc": {
    "message": "Banner sticky per messaggi fissati dai mod, così non perdi regole o programma."
  },
  "mc_settings_dim_timeouts": {
    "message": "attenua messaggi con timeout"
  },
  "mc_settings_dim_timeouts_desc": {
    "message": "Mostra messaggi con timeout e bannati al 50% di opacità invece di nasconderli, stile FFZ/BTTV. Vedi cosa è stato eliminato senza lasciare la chat."
  },
  "mc_settings_smart_completion": {
    "message": "completamento tab intelligente"
  },
  "mc_settings_smart_completion_desc": {
    "message": "Chatter recenti ed emote di questo canale appaiono per primi nel completamento tab. Più veloce dell'alfabetico quando la chat scorre."
  },
  "mc_settings_first_chatter": {
    "message": "alone primo messaggio"
  },
  "mc_settings_first_chatter_desc": {
    "message": "Marker arancione sul bordo del primo messaggio che un utente invia in ogni canale in questa sessione. Rende visibili i nuovi arrivati nelle chat veloci."
  },
  "mc_settings_keyword_highlights": {
    "message": "evidenzia parole chiave"
  },
  "mc_settings_keyword_highlights_desc": {
    "message": "I messaggi contenenti una di queste parole prendono una tinta arancione, come una menzione personale. Una per riga, case-insensitive, parole intere."
  },
  "mc_settings_keyword_highlights_placeholder": {
    "message": "una parola chiave per riga"
  },
  "mc_settings_features": {
    "message": "funzionalità"
  },
  "mc_settings_auto_claim": {
    "message": "auto-riscatto punti canale"
  },
  "mc_settings_auto_claim_desc": {
    "message": "Clicca automaticamente lo scrigno bonus dei punti canale su Twitch quando appare. Punti gratis, zero sforzo."
  },
