  "mc_settings_emote_size_desc": {
    "message": "Pendarab resolusi untuk emote dalam chat. 1x tajam dan padat, 2x tempat manis untuk kebanyakan paparan, 4x untuk yang mahu lihat setiap piksel."
  },
  "mc_settings_input_preview_desc": {
    "message": "Tunjuk emote sebagai imej terus dalam kotak input semasa anda menaip, bukan nama teks. Apa yang anda lihat itulah yang anda hantar."
  },
  "mc_settings_clickable_links_desc": {
    "message": "Tukar URL dalam mesej chat menjadi pautan boleh klik. Matikan jika anda lebih suka copy-paste atau tidak percaya orang asing di internet."
  },
  "mc_settings_vi_mode_desc": {
    "message": "Pintasan gaya Vim untuk navigasi chat. j/k tatal, g/G atas/bawah, / cari. Untuk yang fikir tetikus untuk casual."
  },
  "mc_settings_zebra_desc": {
    "message": "Bayangan baris berselang-seli pada mesej chat. Memudahkan menjejaki mesej panjang, terutama dalam chat pantas."
  },
  "mc_settings_auto_hide_desc": {
    "message": "Sembunyikan bar input apabila anda tidak menaip. Klik atau mula menaip untuk pulangkan. Maksimumkan ruang paparan chat."
  },
  "mc_settings_timestamps_desc": {
    "message": "Tunjuk masa hantar setiap mesej di sebelah nama pengguna. Berguna untuk menyusul apa yang berlaku semasa AFK."
  },
  "mc_settings_avatars_desc": {
    "message": "Tunjuk gambar profil di sebelah nama pengguna. Memudahkan kenal pasti regular secara visual, tukar sedikit ruang menegak."
  },
  "mc_settings_inline_notifs": {
    "message": "notifikasi inline"
  },
  "mc_settings_notif_op": {
    "message": "[OP] siaran asal"
  },
  "mc_settings_notif_op_reply": {
    "message": "[OP] OP balas dalam thread sendiri"
  },
  "mc_settings_notif_re": {
    "message": "[RE] balasan"
  },
  "mc_settings_notif_dm": {
    "message": "[DM] whispers dan DM"
  },
  "mc_settings_notif_op_desc": {
    "message": "Notifikasi dalam tab chat aktif apabila seseorang membuat siaran baru di feed."
  },
  "mc_settings_notif_op_reply_desc": {
    "message": "Notifikasi apabila penyiar asal membalas dalam thread sendiri."
  },
  "mc_settings_notif_re_desc": {
    "message": "Notifikasi untuk setiap balasan dalam mana-mana thread feed."
  },
  "mc_settings_notif_dm_desc": {
    "message": "Notifikasi apabila anda menerima whisper atau DM."
  },
  "mc_settings_twitch_events": {
    "message": "acara Twitch"
  },
  "mc_settings_raids": {
    "message": "raids"
  },
  "mc_settings_raids_desc": {
    "message": "Banner inline apabila streamer raid masuk atau keluar, dengan jumlah penonton dan saluran sumber. Membolehkan anda mengikut ke stream seterusnya."
  },
  "mc_settings_hype_trains": {
    "message": "hype train"
  },
  "mc_settings_hype_trains_desc": {
    "message": "Banner kemajuan langsung untuk hype train, dengan tahap dan pemasa sumbangan. Mati lalai kerana sentiasa dicetus pada saluran besar."
  },
  "mc_settings_gift_subs": {
    "message": "sub hadiah"
  },
  "mc_settings_gift_subs_desc": {
    "message": "Banner untuk gift sub bom komuniti dan hadiah individu, dengan pemberi, penerima dan tier."
  },
  "mc_settings_redeems": {
    "message": "tukar channel point"
  },
  "mc_settings_redeems_desc": {
    "message": "Notifikasi inline untuk tukar channel point seperti 'highlight my message' supaya anda lihat pada apa orang habiskan poin."
  },
  "mc_settings_prediction_banner": {
    "message": "ramalan"
  },
  "mc_settings_prediction_banner_desc": {
    "message": "Banner langsung ramalan channel point dengan odds semasa dan masa berbaki untuk kunci undian."
  },
  "mc_settings_poll_banner": {
    "message": "tinjauan"
  },
  "mc_settings_poll_banner_desc": {
    "message": "Banner tinjauan aktif dengan kiraan undi dan masa berbaki. Undi terus dari overlay."
  },
  "mc_settings_pinned_messages": {
    "message": "mesej disematkan"
  },
  "mc_settings_pinned_messages_desc": {
    "message": "Banner sticky untuk mesej chat yang disematkan moderator supaya anda tidak terlepas peraturan atau jadual."
  },
  "mc_settings_dim_timeouts": {
    "message": "malapkan mesej timeout"
  },
  "mc_settings_dim_timeouts_desc": {
    "message": "Tunjuk mesej timeout dan ban pada 50% kelegapan bukan menyembunyikan, gaya FFZ/BTTV. Membolehkan anda lihat apa yang dipadam tanpa keluar dari chat."
  },
  "mc_settings_smart_completion": {
    "message": "autolengkap tab pintar"
  },
  "mc_settings_smart_completion_desc": {
    "message": "Penyumbang chat terkini dan emote saluran ini muncul dahulu pada autolengkap tab. Lebih pantas daripada abjad apabila chat berjalan."
  },
  "mc_settings_first_chatter": {
    "message": "cahaya mesej pertama"
  },
  "mc_settings_first_chatter_desc": {
    "message": "Penanda jingga di tepi mesej pertama yang pengguna hantar di setiap saluran sesi ini. Mudahkan kenal pasti pendatang baru dalam chat pantas."
  },
  "mc_settings_keyword_highlights": {
    "message": "serlah kata kunci"
  },
  "mc_settings_keyword_highlights_desc": {
    "message": "Mesej yang mengandungi mana-mana kata ini dapat warna jingga, seperti sebutan peribadi. Satu sebaris, tidak kira huruf besar/kecil, perkataan penuh."
  },
  "mc_settings_keyword_highlights_placeholder": {
    "message": "satu kata kunci sebaris"
  },
  "mc_settings_features": {
