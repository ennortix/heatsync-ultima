  "mc_settings_emote_size_desc": {
    "message": "Sohbetteki emote'lar için çözünürlük çarpanı. 1x net ve kompakt, 2x çoğu ekran için ideal nokta, 4x emote sanatının her pikselini görmek isteyenler için."
  },
  "mc_settings_input_preview_desc": {
    "message": "Yazarken emote'ları girdi kutusunda düz metin yerine doğrudan görsel olarak gösterir. Ne görüyorsan onu gönderirsin."
  },
  "mc_settings_clickable_links_desc": {
    "message": "Sohbet mesajlarındaki URL'leri tıklanabilir bağlantılara dönüştürür. Kopyala-yapıştır yapmayı tercih ediyorsan veya internetteki yabancılara güvenmiyorsan devre dışı bırak."
  },
  "mc_settings_vi_mode_desc": {
    "message": "Sohbet navigasyonu için Vim tarzı kısayollar. j/k kaydırmak için, g/G üst/alt için, / arama için. Farenin casuallar için olduğunu düşünenler için."
  },
  "mc_settings_zebra_desc": {
    "message": "Sohbet mesajlarında dönüşümlü satır gölgelendirmesi. Özellikle hızlı sohbette uzun mesajları takip etmeyi kolaylaştırır."
  },
  "mc_settings_auto_hide_desc": {
    "message": "Mesaj yazmadığında girdi çubuğunu gizler. Geri getirmek için tıkla veya yazmaya başla. Sohbet görüntüleme alanını maksimize eder."
  },
  "mc_settings_timestamps_desc": {
    "message": "Her mesajın gönderilme saatini kullanıcı adının hemen yanında gösterir. AFK iken neler olduğunu takip etmek için kullanışlıdır."
  },
  "mc_settings_avatars_desc": {
    "message": "Sohbette kullanıcı adlarının yanında profil resimlerini gösterir. Düzenli izleyicileri görsel olarak tanımayı kolaylaştırır, biraz dikey alan harcar."
  },
