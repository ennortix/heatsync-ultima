{
  "manifest_version": 2,
  "default_locale": "en",
  "name": "__MSG_manifest_name__",
  "version": "1.3.3",
  "description": "__MSG_manifest_description__",
  "author": "heatsync.org",
  "homepage_url": "https://heatsync.org",

  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "cookies",
    "alarms",
    "notifications",
    "webRequest",
    "webRequestBlocking",
    "https://static-cdn.jtvnw.net/*",
    "https://heatsync.org/*",
    "https://www.heatsync.org/*",
    "https://*.twitch.tv/*",
    "https://kick.com/*",
    "https://*.kick.com/*",
    "https://api.betterttv.net/*",
    "https://api.frankerfacez.com/*",
    "https://7tv.io/*",
    "https://events.7tv.io/*",
    "https://cdn.betterttv.net/*",
    "https://cdn.7tv.app/*",
    "https://recent-messages.robotty.de/api/v2/recent-messages/*",
    "https://api.twitch.tv/*",
    "https://decapi.me/*",
    "https://www.youtube.com/*",
    "https://api.chatterino.com/badges"
  ],

  "content_security_policy": "script-src 'self'; object-src 'none'",

  "background": {
    "scripts": ["background.js"]
  },

  "content_scripts": [
    {
      "matches": ["https://*.twitch.tv/*"],
      "js": ["early-inject-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.twitch.tv/*", "https://kick.com/*", "https://*.kick.com/*", "https://www.youtube.com/*"],
      "js": ["pcard-early.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.twitch.tv/*", "https://kick.com/*", "https://*.kick.com/*", "https://www.youtube.com/*"],
      "js": ["vi-mode.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://*.twitch.tv/*"],
      "js": ["emoji-data.js", "autocomplete-hook.js"],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "matches": ["https://kick.com/*", "https://*.kick.com/*"],
      "js": ["kick-autocomplete-hook.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://*.twitch.tv/*",
        "https://kick.com/*",
        "https://*.kick.com/*",
        "https://heatsync.org/*",
        "https://www.heatsync.org/*"
      ],
      "js": ["emoji-data.js", "shared-utils.js", "platform-detector.js", "chat-injector.js", "content.js"],
      "css": ["injected-message.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://*.twitch.tv/*", "https://kick.com/*", "https://*.kick.com/*"],
      "js": ["heatsync-button.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.twitch.tv/*", "https://kick.com/*", "https://*.kick.com/*", "https://www.youtube.com/*"],
      "js": ["emoji-data.js", "shared-utils.js", "multichat.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://www.youtube.com/live_chat*"],
      "js": ["emoji-data.js", "shared-utils.js", "platform-detector.js"],
      "run_at": "document_end",
      "all_frames": true
    },
    {
      "matches": ["https://www.youtube.com/live_chat*"],
      "js": ["heatsync-button.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://www.youtube.com/live_chat*"],
      "js": ["youtube-content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png"
    },
    "default_title": "__MSG_manifest_name__"
  },


  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },

  "web_accessible_resources": [
    "icon-16.png",
    "icon-48.png",
    "icon-48-black.png",
    "COGGERS-1x.webp",
    "_locales/*/messages.json"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "heatsync@heatsync.org",
      "strict_min_version": "128.0"
    }
  }
}
