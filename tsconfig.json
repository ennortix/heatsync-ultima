{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "ES2022.Object", "DOM", "DOM.Iterable", "WebWorker"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["chrome"]
  },
  "include": [
    "types/**/*.d.ts",
    "src/lib/**/*.js",
    "build.js",
    "tests/**/*.js",
    "tools/**/*.js"
  ],
  "exclude": [
    "dist/**",
    "node_modules/**",
    "src/multichat/**",
    "chrome/**"
  ]
}
